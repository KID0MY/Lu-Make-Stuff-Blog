---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import "../styles/postPage.css";
const postFiles = import.meta.glob('../pages/posts/**/*.md', { eager: true });

const allPosts = Object.values(postFiles) as any[];

const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime();
});

const categories = {
  weekly:    { label: "weekly",    sigil: ":3", desc: "short posts, misc thoughts", posts: [] as any[] },
  rambles:   { label: "rambles",   sigil: ":p", desc: "rambles and opinions",       posts: [] as any[] },
  tutorials: { label: "tutorials", sigil: "o-o", desc: "guides & how-tos",          posts: [] as any[] },
  stories:   { label: "stories",   sigil: "|->", desc: "fiction, chapters",         posts: [] as any[] },
};


for (const post of sortedPosts) {
  const cat = post.frontmatter.category ?? 'rambles';
  const key = cat as keyof typeof categories;
  (categories[key] ?? categories.rambles).posts.push(post);
}

// default open tab = first category that has posts, else 'indepth'
const defaultTab = (Object.entries(categories).find(([, v]) => v.posts.length > 0)?.[0]) ?? 'rambles';

const pageName = "Posts";
---
<BaseLayout pageTitle={pageName}>
  <div style="padding-top: 20px;">
    <a href="/rss.xml" class="rss">RSS <svg height="10px" width="10px" viewBox="-271 273 256 256" xml:space="preserve">
      <g>
        <path d="M-271,360v48.9c31.9,0,62.1,12.6,84.7,35.2c22.6,22.6,35.1,52.8,35.1,84.8v0.1h49.1c0-46.6-19-88.7-49.6-119.4C-182.2,379-224.4,360.1-271,360z"></path>
        <path d="M-237,460.9c-9.4,0-17.8,3.8-24,10s-10,14.6-10,24c0,9.3,3.8,17.7,10,23.9c6.2,6.1,14.6,9.9,24,9.9s17.8-3.7,24-9.9s10-14.6,10-23.9c0-9.4-3.8-17.8-10-24C-219.2,464.7-227.6,460.9-237,460.9z"></path>
        <path d="M-90.1,348.1c-46.3-46.4-110.2-75.1-180.8-75.1v48.9C-156.8,322-64.1,414.9-64,529h49C-15,458.4-43.7,394.5-90.1,348.1z"></path>
      </g>
    </svg></a>
  </div>

  <!-- Tab buttons -->
  <div class="tab-bar" role="tablist">
    {Object.entries(categories).map(([key, cat]) => (
      <button
        class={`tab-btn ${key === defaultTab ? 'active' : ''}`}
        role="tab"
        data-tab={key}
        aria-controls={`panel-${key}`}
      >
        <span class="tab-sigil">{cat.sigil}</span>
        <span class="tab-name">{cat.label}</span>
        <span class={`tab-count ${cat.posts.length === 0 ? 'empty' : ''}`}>
          [{cat.posts.length}]
        </span>
      </button>
    ))}
  </div>

  <!-- Tab panels -->
  <div class="tab-panels">
    {Object.entries(categories).map(([key, cat]) => (
      <div
        class={`tab-panel ${key === defaultTab ? 'active' : ''}`}
        id={`panel-${key}`}
        role="tabpanel"
      >
        <div class="panel-desc">{cat.desc}</div>
        {cat.posts.length === 0
          ? <span class="panel-empty">nothing yet...</span>
          : cat.posts.map((post: any) => (
              <BlogPost
                url={post.url}
                title={post.frontmatter.title}
                pubDate={post.frontmatter.pubDate}
                description={post.frontmatter.description}
              />
            ))
        }
      </div>
    ))}
  </div>
</BaseLayout>

<script src="../scripts/tabs.js"></script>