---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";

const postFiles = import.meta.glob('../pages/posts/**/*.md', { eager: true });
const allPosts = Object.values(postFiles) as any[];

const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime();
});

const categories = {
  weekly:    { label: "weekly",    posts: [] as any[] },
  rambles:   { label: "rambles",   posts: [] as any[] },
  tutorials: { label: "tutorials", posts: [] as any[] },
  stories:   { label: "stories",   posts: [] as any[] },
};

for (const post of sortedPosts) {
  const cat = post.frontmatter.category ?? 'rambles';
  const key = cat as keyof typeof categories;
  (categories[key] ?? categories.rambles).posts.push(post);
}


// default open tab = first category that has posts, else 'indepth'
const defaultTab = (Object.entries(categories).find(([, v]) => v.posts.length > 0)?.[0]) ?? 'rambles';

const pageName = "Posts";
---

<style>
  .rss {
    text-decoration: none;
    padding: 2px 4px;
    background-color: #ff8012;
    color: var(--primary-bg-color);
    transition: all 0.3s ease;
    font-size: 0.8rem;
  }
  .rss:hover { background-color: #A34C00; color: var(--primary-color); }
  svg.rss { fill: var(--primary-bg-color); vertical-align: middle; }

  /* ── top bar ── */
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0 0;
    font-size: 0.75rem;
    opacity: 0.4;
  }

  /* ── tab bar ── */
  .tab-bar {
    display: flex;
    flex-direction: row;
    border-bottom: 1px solid var(--secondary-bg-color);
    margin-top: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tab-bar::-webkit-scrollbar { display: none; }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.1rem;
    cursor: pointer;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--primary-color);
    font-family: 'JetBrains', monospace;
    font-size: 0.82rem;
    opacity: 0.4;
    white-space: nowrap;
    transition: opacity 0.15s, border-color 0.2s;
    margin-bottom: -1px;
  }
  .tab-btn:hover { opacity: 0.75; }
  .tab-btn.active {
    opacity: 1;
    border-bottom-color: var(--highlight-color);
  }
  .tab-btn.active .tab-sigil { opacity: 1; }

  .tab-sigil {
    color: var(--highlight-color);
    font-family: 'JetBrains-Bold', monospace;
    font-size: 0.8rem;
    opacity: 0.55;
  }
  .tab-name {
    font-family: 'JetBrains-Bold', monospace;
    letter-spacing: 0.04em;
  }
  .tab-count {
    font-size: 0.65rem;
    color: var(--highlight-color);
    opacity: 0.65;
  }
  .tab-count.empty { color: var(--primary-color); opacity: 0.2; }

  /* ── panels ── */
  .tab-panels { padding-top: 0; }

  .tab-panel {
    display: none;
    flex-direction: column;
    padding: 0.9rem 0 2rem;
    animation: fadeIn 0.15s ease;
  }
  .tab-panel.active { display: flex; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(3px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .panel-desc {
    font-size: 0.72rem;
    opacity: 0.3;
    font-family: 'NotoSerif', serif;
    font-style: italic;
    padding-bottom: 0.7rem;
    border-bottom: 1px dotted rgba(212,42,99,0.2);
    margin-bottom: 0.4rem;
  }

  .panel-empty {
    font-size: 0.78rem;
    opacity: 0.25;
    font-style: italic;
    font-family: 'NotoSerif', serif;
    padding: 0.4rem 0.5rem;
  }

  @media (max-width: 500px) {
    .tab-btn { padding: 0.65rem 0.7rem; gap: 0.3rem; }
    .tab-name { display: none; }
  }
</style>

<BaseLayout pageTitle={pageName}>
  <div class="top-bar">
    <span>:~$ ls posts/</span>
    <a href="/rss.xml" class="rss">RSS <svg height="9px" width="9px" viewBox="-271 273 256 256" xml:space="preserve">
      <g>
        <path d="M-271,360v48.9c31.9,0,62.1,12.6,84.7,35.2c22.6,22.6,35.1,52.8,35.1,84.8v0.1h49.1c0-46.6-19-88.7-49.6-119.4C-182.2,379-224.4,360.1-271,360z"></path>
        <path d="M-237,460.9c-9.4,0-17.8,3.8-24,10s-10,14.6-10,24c0,9.3,3.8,17.7,10,23.9c6.2,6.1,14.6,9.9,24,9.9s17.8-3.7,24-9.9s10-14.6,10-23.9c0-9.4-3.8-17.8-10-24C-219.2,464.7-227.6,460.9-237,460.9z"></path>
        <path d="M-90.1,348.1c-46.3-46.4-110.2-75.1-180.8-75.1v48.9C-156.8,322-64.1,414.9-64,529h49C-15,458.4-43.7,394.5-90.1,348.1z"></path>
      </g>
    </svg></a>
  </div>

  <!-- Tab buttons -->
  <div class="tab-bar" role="tablist">
    {Object.entries(categories).map(([key, cat]) => (
      <button
        class={`tab-btn ${key === defaultTab ? 'active' : ''}`}
        role="tab"
        data-tab={key}
        aria-controls={`panel-${key}`}
      >
        <span class="tab-sigil">{cat.sigil}</span>
        <span class="tab-name">{cat.label}</span>
        <span class={`tab-count ${cat.posts.length === 0 ? 'empty' : ''}`}>
          [{cat.posts.length}]
        </span>
      </button>
    ))}
  </div>

  <!-- Tab panels -->
  <div class="tab-panels">
    {Object.entries(categories).map(([key, cat]) => (
      <div
        class={`tab-panel ${key === defaultTab ? 'active' : ''}`}
        id={`panel-${key}`}
        role="tabpanel"
      >
        <div class="panel-desc">{cat.desc}</div>
        {cat.posts.length === 0
          ? <span class="panel-empty">nothing yet...</span>
          : cat.posts.map((post: any) => (
              <BlogPost
                url={post.url}
                title={post.frontmatter.title}
                pubDate={post.frontmatter.pubDate}
                description={post.frontmatter.description}
              />
            ))
        }
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById('panel-' + tab.dataset.tab)?.classList.add('active');
    });
  });
</script>