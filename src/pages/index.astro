---
const pageTitle = "hello, world!";
import "../styles/mainPage.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <main>
            <div class="centered">
                <h1>Hi, I am Lu :D</h1>
                <div>
                    <span class="inline-heading"
                        ><h3>I like to make stuff</h3></span
                    >
                    <span class="inline-heading"><h3 class="pisca">_</h3></span>
                </div>
            </div>
            <div class="Box-MD">
                <h2>:~$ whoami</h2>
                <p>
                    This blog is where I share my silly adventures! I like
                    computers, trains, photograpy, 3D Printers, graphic design
                    and baking from time to time.
                </p>
                <nav>
                    <h2>
                        <a href="/posts/" class="nav-link"
                            >My Blog Posts -&gt;</a>
                    </h2>
                    <p>This is some stuff I wrote and am proud of :D</p>
                    <ul>
                        <a href="/posts/" class="nav-link">>> Chicken jockey</a>
                    </ul>
                </nav>
            </div>
        </main>
        <Footer />
    </body>
</html>
