---
const pageTitle = "Hi, I'm Lu :)";
import "../styles/mainPage.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { Image } from 'astro:assets'
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <main>
            <div class="centered">
                <h1>Hi, I am Lu :D</h1>
                <div>
                    <span class="inline-heading"><h3>I like to make stuff</h3></span>
                    <span class="inline-heading"><h3 class="pisca">_</h3></span>
                </div>
            </div>
            <div class="Box-MD">
                <h2>:~$ whoami</h2>
                <p>
                    Hi, I'm Lu! I am a queer game dev/computer nerd and 
                    I do a bit of everything, from graphic design to back-end. 
                    I love taking photos and love learning abbout news stuff!
                </p>
                <nav>
                    <h2>
                        <a href="/posts/" class="reveal-link">My Blog Posts -&gt;</a>
                    </h2>
                    <p>My latest Weekly Post</p>
                    <li>
                        <a href="/posts/weekly/weekly_03_160526">Witch Hat Atelier is Peak!</a>
                    </li>
                    <p>This is some stuff I wrote and am proud of :D</p>
                    <li>
                        <a href="/posts/rambles/How to not make a website/">How to Not make a website</a>
                    </li>
                    <li><a href="/posts/rambles/Xenia my Beloved/">Xenia my Beloved</a></li>
                </nav>
                <nav>
                    <h2>
                        <a href="/photography/" class="reveal-link">My Photography -&gt;</a>
                    </h2>
                    <li>
                        <a href="/cool-secret-photo/">404 - photos not found</a>
                    </li>
                </nav>
                <h2>Cool things :D</h2>
                <nav>
                    <a href=https://www.youtube.com/watch?v=OF_5EKNX0Eg class="badges"><Image src={import("/src/images/badges/xenia.gif")} alt="Powered by linux"></a>
                    <a class="badges"><Image src={import("/src/images/badges/queerpride.gif")} alt="queer pride!"></a>
                    <a href=https://astro.build class="badges"><Image src={import("/src/images/badges/astro.png")} alt="Powered by Astro"></a>
                    <a href=https://www.fedoraproject.org/ class="badges"><Image src={import("/src/images/badges/fedora.png")} alt="my distro of choice"></a>
                    <a href=https://jellyfin.org/ class="badges"><Image src={import("/src/images/badges/jellyfin.gif")} alt="Jellyfin is so"></a>
                    <a href=https://queercomputerclub.ca/ class="badges"><Image src={import("/src/images/badges/queercomputerclub.png")} alt="Cool Queer Club"></a>
                </nav>
                <h2>Wants to reference me?</h2>
                <nav>
                    <a href=https://lumakestuff.dev class="badges"><Image src={import("/src/images/badges/lumakestuff.png")} alt="lu make stuff 88x31"></a>
                </nav>
            </div>
        </main>
        <Footer />
    </body>
</html>
