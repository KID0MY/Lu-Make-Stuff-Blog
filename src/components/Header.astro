---
const { title } = Astro.props;
const pathname = Astro.url.pathname;
 
const pathSegments = pathname.split('/').filter(Boolean);
// ['posts', 'rambles', 'xenia-my-beloved']
 
// Drop last segment on post pages — it's the post folder, replaced by title
const crumbSegments = title ? pathSegments.slice(0, -1) : pathSegments;
// ['posts', 'rambles']
 
// Categories get a special href: back to /posts/ with an anchor to their tab
const categoryHrefs: Record<string, string> = {
  weekly:    '/posts/#weekly',
  rambles:   '/posts/#rambles',
  tutorials: '/posts/#tutorials',
  stories:   '/posts/#stories',
};
 
const crumbs = crumbSegments.map((segment, i) => ({
  label: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
  href: categoryHrefs[segment] ?? '/' + crumbSegments.slice(0, i + 1).join('/') + '/',
}));
---
 
<header>
  <div class="Box">
    <h4>
      <a href="/">Home/</a>{' '}
      {crumbs.map(crumb => (
        <><a href={crumb.href}>{crumb.label}/</a>{' '}</>
      ))}
      {title && <span>{title}.md</span>}
    </h4>
  </div>
</header>