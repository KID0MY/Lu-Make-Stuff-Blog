---
const { title, url, pubDate, description } = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric', 
});
---

<style>
    p{
        margin: 0px;
    }
    h2{
        margin-bottom: 0px;
    }
</style>
<div>
    <a href={url}>
        <h2 class="reveal-link">{title}</h2>
        <p>{description}</p>
        <i class="date">Published {formattedDate}</i>
    </a>
</div>